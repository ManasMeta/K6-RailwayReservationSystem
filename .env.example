# Copy to .env (never commit .env).
# Names only: put real values in .env locally and in GitHub Environments / your host for deploys.

# Admin connection, used by migrations and for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nrrms
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# Restricted login the API connects as (member of nrrms_app, subject to row-level security)
APP_DB_USER=nrrms_api
APP_DB_PASSWORD=change-me

# Signs login tokens: at least 32 random characters. There is no default.
JWT_SECRET=replace-with-a-long-random-string

FRONTEND_PORT=8080
